// example.com: static assets; src/worker.js runs only for /units/data.json (the unit finder's data proxy).
// Deploy: ../cdn-worker/node_modules/.bin/wrangler deploy --config wrangler.jsonc   (see README.md)
{
  "name": "bf-site",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/units/data.json"],
    // any unknown path shows the promo page instead of an empty 404
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "example.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
